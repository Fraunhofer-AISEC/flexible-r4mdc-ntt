CAPI=2:
name: "aisec:dv:ntt_r4mdc:0.1"
description: "Radix-4 MDC NTT DV"

filesets:
  files_dv:
    depend:
      - aisec:dv:tb_pkg
      - aisec:ip:ntt_r4mdc
    files:
      - tb/tester_ntt_r4mdc.sv
      - tb/tb_ntt_r4mdc.sv
    file_type: systemVerilogSource

parameters:

  LOG_FILE:
    datatype: str
    description: File location for log file
    default: "../../../lololog.log"
    paramtype: vlogparam

  TEX_FILE:
    datatype: str
    description: File location to save results in .tex form
    default:  "../../../lololog.tex"
    paramtype: vlogparam

  TWIDDLE_MEM_PATH:
    datatype: str
    description: Twiddle ROM initialization file in vmem hex format
    default: "/home/stelzer/projects/aisec/fhe-sv/hw/ip/ntt/mem/cggi_std_128_mem_solina27"
    paramtype: vlogparam

  NOF_BUTTERFLY_UNITS:
    datatype: int
    description: Number of parallel processing elements
    default: 1
    paramtype: vlogparam

  DATA_WIDTH:
    datatype: int
    description: Width of data path
    default: 27
    paramtype: vlogparam

  N:
    datatype: int
    description: Polynomial degree
    default: 1024
    paramtype: vlogparam

  QINT:
    datatype: int
    description: Modulus
    default: 134215681
    paramtype: vlogparam

  QDASH:
    datatype: int
    description: Constant for montgomery multiplication
    default: 130021375
    paramtype: vlogparam

  W4:
    datatype: int
    description: 4th root of unity
    default: 37361560
    paramtype: vlogparam

  LOG_R:
    datatype: int
    description: Constant for montgomery multiplication
    default: 27
    paramtype: vlogparam

  QMU:
    datatype: int
    description: Constant for barrett multiplication
    default: 134219775
    paramtype: vlogparam

  K:
    datatype: int
    description: Constant for barrett multiplication
    default: 54
    paramtype: vlogparam

  REDUCTION:
    datatype: str
    description: Reduction method for multply operations
    default: "SPARSE"
    paramtype: vlogparam

  DELAY_BF:
    datatype: int
    description: Latency of butterfly unit implementation
    default: 11
    paramtype: vlogparam

  DELAY_MULT:
    datatype: int
    description: Latency of multiplier implementation
    default: 5
    paramtype: vlogparam

  TESTCASE_PATH:
    datatype: str
    description: File location for log file
    default: "../../../hw/dv/testvectors/r4ntt_std128/"
    paramtype: vlogparam

  TEST_NAME:
    datatype: str
    description: File location for log file
    default: "std128_0"
    paramtype: vlogparam   

  BUTTERFLY_TYPE:
    datatype: str
    description: File location for log file
    default: "CT"
    paramtype: vlogparam  

targets:
  default: &default_target
    default_tool: modelsim
    filesets:
      - files_dv
    toplevel: tb_ntt_r4mdc
